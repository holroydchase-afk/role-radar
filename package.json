{
  "name": "role-radar",
  "version": "0.1.0",
  "private": true,
  "description": "A job-search radar: weekday scan, criteria-as-code scoring, and one tracker for roles and recruiters.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bash scripts/check-agents.sh && node scripts/check-logs.mjs && node --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "node scripts/build.mjs",
    "check:agents": "bash scripts/check-agents.sh",
    "check:logs": "node scripts/check-logs.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check:private": "node scripts/check-private.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "build:pages": "node scripts/build-demo.mjs --public",
    "review:shots": "node scripts/review-shots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "typescript": "7.0.2"
  }
}
